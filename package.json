{
  "name": "zarai-mandi-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "cmd /c \"cd /d \"%cd%\\urdu-tts-backend\" && call run_backend.bat\"",
    "dev:frontend": "cmd /c \"cd /d \"%cd%\\FULL APP\" && npm run dev\"",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
